    {"name": "a container in a list item", "markdown": "- ::: claim\n  A claim $c$.\n  :::\n", "blocks": [["list", 0, 0, 3], ["list_item", 1, 0, 3], ["container", 2, 0, 3], ["paragraph", 3, 1, 2]], "math": [[3, "inline", "c"]]},
    {"name": "LaTeX's own delimiters", "markdown": "Inline \\(x^2\\) and\n\\[\ny = 1\n\\]\nafter \\[z\\] text.\n", "blocks": [["paragraph", 0, 0, 1], ["equation", 0, 1, 4], ["paragraph", 0, 4, 5]], "math": [[0, "inline", "x^2"], [1, "display", "\ny = 1\n"], [2, "display", "z"]]},
    {"name": "a display environment", "markdown": "Result:\n\\begin{align}\na &= b\n\\end{align}\ndone\n", "blocks": [["paragraph", 0, 0, 1], ["equation", 0, 1, 4], ["paragraph", 0, 4, 5]], "math": [[1, "display", "\\begin{align}\na &= b\n\\end{align}"]]},
    {"name": "delimiters in a quote and a list", "markdown": "> \\[\n> q\n> \\]\n\n- \\[ w \\]\n", "blocks": [["quote", 0, 0, 3], ["equation", 1, 0, 3], ["list", 0, 4, 5], ["list_item", 1, 4, 5], ["equation", 2, 4, 5]], "math": [[1, "display", "\nq\n"], [4, "display", " w "]]},
    {"name": "a figure", "markdown": "![A plot of $f$](https://example.org/f.png)\n\nText ![inline](https://example.org/g.png) here.\n", "blocks": [["paragraph", 0, 0, 1], ["paragraph", 0, 2, 3]], "math": []},
    {"name": "links keep their math", "markdown": "[see $x$](https://example.org) and [rel $y$](notes.md).\n", "blocks": [["paragraph", 0, 0, 1]], "math": [[0, "inline", "x"], [0, "inline", "y"]]},
    {"name": "a display block in a quote keeps the quote markers", "markdown": "> $$\n> q\n> $$\n", "blocks": [["quote", 0, 0, 3], ["equation", 1, 0, 3]], "math": [[1, "display", "\n> q\n> "]]},
