{
  "name": "sandbox-science-workspace-web",
  "version": "0.1.0",
  "description": "The Sandbox Science research workspace GUI",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build:math": "vite build --config vite.math.config.ts && node server/copy-math-licenses.mjs"
  },
  "dependencies": {
    "katex": "0.18.9",
    "markdown-it": "15.0.2",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
