{
  "name": "sandbox-science-workspace-web",
  "version": "0.1.0",
  "description": "The Sandbox Science research workspace GUI",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.viewer.config.ts && vite build --config vite.figures.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "build:math": "vite build --config vite.math.config.ts && vite build --config vite.figurecheck.config.ts && node server/copy-math-licenses.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-svelte"
    ]
  },
  "dependencies": {
    "@napi-rs/canvas": "file:stubs/no-canvas",
    "katex": "0.18.9",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.3.289",
    "svelte": "5.57.1",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "happy-dom": "21.0.4",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@napi-rs/canvas": "$@napi-rs/canvas"
  }
}
